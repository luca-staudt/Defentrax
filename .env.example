# Sentinel — copy to `.env` (never commit `.env`)
# Generate secrets:
#   openssl rand -base64 32   # SESSION_SECRET / TOTP / SECRETS / POSTGRES_PASSWORD

# --- Docker Compose image tag (immutable SemVer recommended; avoid :latest in prod) ---
SENTINEL_IMAGE_TAG=0.1.0

# --- PostgreSQL (compose service `postgres`) ---
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=CHANGE_ME_USE_OPENSSL_RAND
POSTGRES_DB=sentinel
# Dev overlay only (docker-compose.dev.yml):
# POSTGRES_HOST_PORT=5432

# --- Published host ports ---
API_HOST_PORT=8080
FRONTEND_HOST_PORT=3000
# PROXY_HOST_PORT=80
# REDIS_HOST_PORT=6379

# --- Application ---
APP_ENV=development
API_PORT=8080
LOG_LEVEL=info

# Compose wires DATABASE_URL / REDIS_URL to service DNS; these are for bare-metal runs:
DATABASE_URL=postgres://sentinel:CHANGE_ME_USE_OPENSSL_RAND@localhost:5432/sentinel?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Required when DATABASE_URL is set. Generate: openssl rand -base64 32
SESSION_SECRET=

# Session cookie and lifetime
SESSION_COOKIE_NAME=sentinel_session
SESSION_TTL_HOURS=24
# Local HTTP (compose default): keep false. Set true behind HTTPS.
COOKIE_SECURE=false

# TOTP secret encryption at rest (32 bytes, base64). Generate: openssl rand -base64 32
TOTP_ENCRYPTION_KEY=

# Login / ingest / enroll rate limiting and detection windows
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_SEC=60
ENROLL_RATE_LIMIT_MAX=30
ENROLL_RATE_LIMIT_WINDOW_SEC=60
INGEST_RATE_LIMIT_MAX=120
INGEST_RATE_LIMIT_WINDOW_SEC=60
INGEST_MAX_BATCH_SIZE=100
INGEST_MAX_BODY_BYTES=4194304
INGEST_DB_TIMEOUT_SEC=15

# Alert deduplication cooldown (seconds)
ALERT_DEDUP_COOLDOWN_SEC=900

# Optional API process TLS (both required). Prefer terminating TLS at a reverse proxy.
# When set, COOKIE_SECURE must be true.
# API_TLS_CERT_FILE=
# API_TLS_KEY_FILE=

# Detection rule packs directory (optional)
# SENTINEL_RULES_PATH=

# Plugin system. Empty allowlist admits nothing (secure default).
# SENTINEL_PLUGIN_DIR=sentinel/plugins/examples
# SENTINEL_PLUGIN_ALLOWLIST=echo-parser
# SENTINEL_PLUGIN_REQUIRE_SIGNATURE=false
# SENTINEL_PLUGIN_TRUSTED_PUBLIC_KEY=

# Notification channel secrets at rest (AES-256-GCM). Generate: openssl rand -base64 32
# SECRETS_ENCRYPTION_KEY=

NOTIFY_MAX_ATTEMPTS=5
NOTIFY_BASE_BACKOFF_MS=500
NOTIFY_MAX_BACKOFF_MS=30000

# One-time first admin when users table is empty (compose / API bootstrap)
# SENTINEL_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# SENTINEL_BOOTSTRAP_ADMIN_PASSWORD=

# Dev seed (NEVER enable in production). Requires APP_ENV=development.
# SENTINEL_SEED_DEV=true
# SENTINEL_DEV_ADMIN_PASSWORD=
# SENTINEL_DEV_ADMIN_EMAIL=admin@localhost

# Browser UI origins (comma-separated). Required for local frontend.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend (browser WebSocket URL — must be reachable from the browser)
NEXT_PUBLIC_WS_URL=ws://localhost:8080
# Bare-metal Next.js only:
# API_PROXY_TARGET=http://127.0.0.1:8080
# API_INTERNAL_URL=http://127.0.0.1:8080

# --- Optional compose profile: agent ---
# SENTINEL_ENROLLMENT_TOKEN=
# SENTINEL_AGENT_NAME=compose-agent
# SENTINEL_AUTH_LOG_HOST_PATH=/var/log/auth.log
# SENTINEL_DOCKER_ENABLED=false

# --- Reserved / documented elsewhere ---
# Agent lab only: SENTINEL_TLS_INSECURE=true
# Production break-glass only: ALLOW_INSECURE_COOKIES=true
# API_TLS_CERT=
# API_TLS_KEY=
