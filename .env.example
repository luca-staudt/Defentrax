# Sentinel API — environment variables (copy to .env for local dev; never commit .env)
# Phase 2: API foundation only. Database, Redis, and auth vars are reserved for later phases.

# Application environment: development | staging | production
APP_ENV=development

# HTTP listen port for the control-plane API
API_PORT=8080

# Log level: debug | info | warn | error
LOG_LEVEL=info

# --- Reserved for Phase 3+ (documented; not used in Phase 2) ---
# DATABASE_URL=postgres://sentinel:CHANGE_ME@localhost:5432/sentinel?sslmode=disable
# REDIS_URL=redis://localhost:6379/0
# SESSION_SECRET=generate-with-openssl-rand-base64-32
# API_TLS_CERT=
# API_TLS_KEY=
