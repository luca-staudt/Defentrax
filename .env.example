# Sentinel API — environment variables (copy to .env for local dev; never commit .env)

# Application environment: development | staging | production
APP_ENV=development

# HTTP listen port for the control-plane API
API_PORT=8080

# Log level: debug | info | warn | error
LOG_LEVEL=info

# PostgreSQL (Phase 3+). When set, /readyz checks database connectivity.
DATABASE_URL=postgres://sentinel:CHANGE_ME@localhost:5432/sentinel?sslmode=disable

# Required when DATABASE_URL is set (Phase 4). Generate: openssl rand -base64 32
SESSION_SECRET=

# Session cookie and lifetime
SESSION_COOKIE_NAME=sentinel_session
SESSION_TTL_HOURS=24
# COOKIE_SECURE=true   # default true outside development

# TOTP secret encryption at rest (32 bytes, base64). Required for 2FA enroll.
# Generate: openssl rand -base64 32
TOTP_ENCRYPTION_KEY=

# Login / ingest rate limiting and detection windows (Redis preferred; in-memory fallback)
REDIS_URL=
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_SEC=60
INGEST_RATE_LIMIT_MAX=120
INGEST_RATE_LIMIT_WINDOW_SEC=60
INGEST_MAX_BATCH_SIZE=100
INGEST_MAX_BODY_BYTES=4194304
INGEST_DB_TIMEOUT_SEC=15

# Alert deduplication cooldown (seconds) for same rule/group_by on a server
ALERT_DEDUP_COOLDOWN_SEC=900

# Detection rule packs directory (optional; defaults to ../rules or sentinel/rules)
# SENTINEL_RULES_PATH=

# Notification channel secrets at rest (AES-256-GCM). Generate: openssl rand -base64 32
# Falls back to TOTP_ENCRYPTION_KEY when unset. Required to create/use notification channels.
# SECRETS_ENCRYPTION_KEY=

# Notification delivery retry / backoff
NOTIFY_MAX_ATTEMPTS=5
NOTIFY_BASE_BACKOFF_MS=500
NOTIFY_MAX_BACKOFF_MS=30000

# One-time first admin when user table is empty (never commit real values)
# SENTINEL_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# SENTINEL_BOOTSTRAP_ADMIN_PASSWORD=

# Dev seed (NEVER enable in production). Requires APP_ENV=development.
# SENTINEL_SEED_DEV=true
# Optional local-only admin for development (never commit a real value):
# SENTINEL_DEV_ADMIN_PASSWORD=
# SENTINEL_DEV_ADMIN_EMAIL=admin@localhost

# CORS for browser UI (comma-separated origins). Example: http://localhost:3000
# CORS_ALLOWED_ORIGINS=

# --- Reserved for later phases ---
# API_TLS_CERT=
# API_TLS_KEY=
