# Sentinel API — environment variables (copy to .env for local dev; never commit .env)

# Application environment: development | staging | production
APP_ENV=development

# HTTP listen port for the control-plane API
API_PORT=8080

# Log level: debug | info | warn | error
LOG_LEVEL=info

# PostgreSQL (Phase 3+). When set, /readyz checks database connectivity.
DATABASE_URL=postgres://sentinel:CHANGE_ME@localhost:5432/sentinel?sslmode=disable

# Dev seed (NEVER enable in production). Requires APP_ENV=development.
# SENTINEL_SEED_DEV=true
# Optional local-only admin for development (never commit a real value):
# SENTINEL_DEV_ADMIN_PASSWORD=
# SENTINEL_DEV_ADMIN_EMAIL=admin@localhost

# --- Reserved for later phases ---
# REDIS_URL=redis://localhost:6379/0
# SESSION_SECRET=generate-with-openssl-rand-base64-32
# API_TLS_CERT=
# API_TLS_KEY=
