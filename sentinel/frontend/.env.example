# Next.js dev server (default 3000)
# Proxy REST calls to the Sentinel API (see next.config.ts rewrites)
API_PROXY_TARGET=http://127.0.0.1:8080

# WebSocket connects directly to the API (not proxied by Next.js)
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8080

# Optional: server-side fetches from RSC (defaults to API_PROXY_TARGET host)
# API_INTERNAL_URL=http://127.0.0.1:8080
